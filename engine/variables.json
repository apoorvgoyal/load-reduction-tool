{
  "_readme": "Design-space bounds for training the surrogate (option B). These are sampling ranges, not defaults or recommendations; widen or narrow them per study. Inputs not listed under 'sampled' are held at the archetype default during training - if a user changes one of those, the UI marks the surrogate as not applicable and asks for an EnergyPlus run.",
  "sampled": {
    "wwr":               {"min": 0.10, "max": 0.80},
    "wall_u":            {"min": 0.15, "max": 1.00},
    "roof_u":            {"min": 0.10, "max": 0.50},
    "win_u":             {"min": 1.00, "max": 3.50},
    "shgc":              {"min": 0.20, "max": 0.60},
    "overhang_pf":       {"min": 0.00, "max": 1.00},
    "m2_per_person":     {"scale_of_default": [0.5, 2.0]},
    "lpd_w_m2":          {"min": 3.0,  "max": 12.0},
    "epd_w_m2":          {"min": 3.0,  "max": 25.0},
    "oa_multiplier":     {"min": 0.75, "max": 2.0, "_note": "scales both archetype oa_per_person_ls and oa_per_area_ls_m2"},
    "erv_sensible_eff":  {"min": 0.0,  "max": 0.85},
    "erv_latent_eff":    {"min": 0.0,  "max": 0.75},
    "infiltration_ach":  {"min": 0.05, "max": 0.60},
    "t_cool_c":          {"min": 22.5, "max": 27.0},
    "t_heat_c":          {"min": 18.0, "max": 22.0, "_note": "kept below the t_cool_c minimum so every sample has a deadband"},
    "n_floors":          {"min": 1,    "max": 15, "int": true},
    "aspect_ratio":      {"min": 1.0,  "max": 3.0},
    "floor_plate_m2":    {"min": 500,  "max": 5000, "_note": "gfa_m2 = floor_plate_m2 * n_floors"},
    "north_axis_deg":    {"min": 0.0,  "max": 180.0}
  },
  "fixed_inputs": ["floor_to_floor_m", "perimeter_depth_m", "activity_w_per_person", "unoccupied_internal_fraction",
                   "occ_start_h", "occ_hours", "cooling_supply_air_c", "heating_supply_air_c", "slab_f_factor_w_mk",
                   "thermal_mass", "setback_heat_c", "setup_cool_c"],
  "post_processed": ["cooling_sizing_factor", "heating_sizing_factor"]
}
